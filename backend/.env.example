# CognoDB connection (from console.cognodb.com)
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=<generated password — shown once, store it now>

# Auth
JWT_SECRET=<strong random string>
JWT_EXPIRES_IN=24h

# Super admin — bootstrapped once on first boot if no super_admin node exists
SUPER_ADMIN_EMAIL=admin@yourorg.com
SUPER_ADMIN_PASSWORD=<temporary password, change after first login>
SUPER_ADMIN_FIRST_NAME=Super
SUPER_ADMIN_LAST_NAME=Admin

PORT=3000
FRONTEND_URL=http://localhost:3001
